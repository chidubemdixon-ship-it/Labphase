# Server
NODE_ENV=development
PORT=5000

# MongoDB
# Local:      mongodb://127.0.0.1:27017/task-manager
# Atlas:      mongodb+srv://<user>:<password>@cluster.mongodb.net/task-manager
MONGO_URI=mongodb://127.0.0.1:27017/task-manager

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS
# The frontend's URL. Comma-separate multiple origins if needed
# (e.g. a deployed frontend URL alongside your local dev server).
# In development, any http://localhost:<port> or http://127.0.0.1:<port>
# origin is also allowed automatically, so Vite picking a different port
# (5174, 5175...) if 5173 is busy won't break the connection.
CLIENT_URL=http://localhost:5173
